Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# The browser uses the Supabase Edge Function directly.
RewriteRule ^api(?:/|$) - [R=404,L]

# Never expose application internals.
RewriteRule ^(?:config|lib|storage|tests|supabase|docs|\.github|\.git)(?:/|$) - [F,L]
RewriteRule \.(?:md|sql|ya?ml|json|lock)$ - [F,L,NC]

<FilesMatch "^(?:\.env(?:\..*)?|database\.php|database\.example\.php)$">
  Require all denied
</FilesMatch>
